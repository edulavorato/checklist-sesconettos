rules_version = '2';

// Regras de segurança do Firestore — ponto de partida restritivo:
// só usuários autenticados podem ler/escrever, e cada um só mexe nos
// dados da própria unidade. Ajustar conforme o modelo de permissões
// (ex.: gerente só vê a própria unidade; admin vê todas) for definido.

service cloud.firestore {
  match /databases/{database}/documents {

    match /checklistRuns/{runId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      match /photos/{itemId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    match /checklistTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if false; // templates só são editados manualmente por enquanto
    }

    // Perfil complementar (nome, cargo, unidade) — cada usuário só lê/edita o próprio.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
