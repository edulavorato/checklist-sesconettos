rules_version = '2';

// Regras de segurança do Firestore.
//
// Papéis (campo `role` em `users/{uid}`): "gerente" (padrão) ou "admin".
// Não existe forma de um usuário virar admin pelo próprio app — o campo
// `role` só pode ser definido/alterado manualmente pelo Firebase Console
// (Firestore Database > users > o documento do usuário > editar campo
// "role" para "admin"). Isso é proposital: sem Cloud Functions no plano
// gratuito, o Console é o único lugar em que dá pra fazer essa promoção
// com segurança.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function myUnit() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unitId
        : null;
    }

    match /checklistRuns/{runId} {
      // Admin lê tudo; gerente só lê aplicações da própria unidade.
      allow read: if request.auth != null && (isAdmin() || resource.data.unitId == myUnit());
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      match /photos/{itemId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    match /checklistTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if false; // templates só são editados manualmente por enquanto
    }

    // Perfil complementar (nome, cargo, unidade, papel) — cada usuário lê/
    // edita o próprio documento, e admin também pode editar nome/cargo/
    // unidade dos logins das unidades (ex: corrigir o nome de exibição de
    // um login compartilhado). Ninguém consegue mudar o `role` por aqui,
    // nem o próprio usuário nem o admin — nem na criação, nem depois: o
    // app nunca envia esse campo, e mesmo que alguém tente forçar via
    // console do navegador, a regra abaixo bloqueia qualquer valor de
    // `role` diferente de "gerente" na criação, e qualquer mudança de
    // `role` na atualização. Continua só dando pra promover alguém a
    // admin manualmente pelo Firebase Console.
    match /users/{userId} {
      // Cada um lê o próprio perfil; admin também lê os perfis de todo
      // mundo, para montar a visão geral por unidade/gerente na tela inicial.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!("role" in request.resource.data) || request.resource.data.role == "gerente");
      // `.get('role', null)` em vez de `.role` direto: a maioria dos logins
      // de gerente nunca teve o campo `role` definido (só quem foi
      // promovido a admin pelo Console tem esse campo). Acessar `.role`
      // direto num documento sem esse campo quebra a avaliação da regra
      // inteira e nega o acesso mesmo sem ninguém estar tentando mudar o
      // papel — `.get(chave, padrão)` evita isso, devolvendo `null` nos
      // dois lados quando o campo simplesmente não existe.
      allow update: if request.auth != null
                    && (request.auth.uid == userId || isAdmin())
                    && request.resource.data.get('role', null) == resource.data.get('role', null);
    }
  }
}
