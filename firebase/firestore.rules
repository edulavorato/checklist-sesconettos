rules_version = '2';

// Regras de segurança do Firestore.
//
// Papéis (campo `role` em `users/{uid}`): "gerente" (padrão) ou "admin".
// Não existe forma de um usuário virar admin pelo próprio app — o campo
// `role` só pode ser definido/alterado manualmente pelo Firebase Console
// (Firestore Database > users > o documento do usuário > editar campo
// "role" para "admin"). Isso é proposital: sem Cloud Functions no plano
// gratuito, o Console é o único lugar em que dá pra fazer essa promoção
// com segurança.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function myUnit() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unitId
        : null;
    }

    match /checklistRuns/{runId} {
      // Admin lê tudo; gerente só lê aplicações da própria unidade.
      allow read: if request.auth != null && (isAdmin() || resource.data.unitId == myUnit());
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      match /photos/{itemId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    match /checklistTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if false; // templates só são editados manualmente por enquanto
    }

    // Perfil complementar (nome, cargo, unidade, papel) — cada usuário só
    // lê/edita o próprio documento, e nunca consegue mudar o próprio `role`
    // por aqui (nem na criação, nem depois): o app nunca envia esse campo,
    // e mesmo que alguém tente forçar via console do navegador, a regra
    // abaixo bloqueia qualquer valor de `role` diferente de "gerente" na
    // criação, e qualquer mudança de `role` na atualização.
    match /users/{userId} {
      // Cada um lê o próprio perfil; admin também lê os perfis de todo
      // mundo, para montar a visão geral por unidade/gerente na tela inicial.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!("role" in request.resource.data) || request.resource.data.role == "gerente");
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
    }
  }
}
